{
  "version": 2,
  "builds": [
    { "src": "**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/admin", "dest": "/admin.html" },
    { "src": "/visiting-card", "dest": "/visiting-card.html" },
    { "src": "/card", "dest": "/visiting-card.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
